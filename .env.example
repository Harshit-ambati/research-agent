# LLM Configuration for SIH Agent
# Copy this file to .env and fill in your credentials.
# Only one provider is needed. Priority: Gemini > Groq > OpenAI > Ollama.

# ─── LLM Provider Settings ─────────────────────────────────────────────────────
# Set one of: gemini | groq | openai | ollama
LLM_PROVIDER=gemini

# Model to use (leave blank to auto-use provider default)
# Gemini:  gemini-1.5-flash (default) | gemini-2.0-flash | gemini-1.5-pro
# Groq:    llama-3.3-70b-versatile (default) | llama3-8b-8192 | mixtral-8x7b-32768
# OpenAI:  gpt-4o-mini (default) | gpt-4o | gpt-3.5-turbo
# Ollama:  llama3.2 (default) | mistral | phi3 | gemma2
LLM_MODEL=

# ─── API Keys ──────────────────────────────────────────────────────────────────
# Get Gemini key free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get Groq key free at: https://console.groq.com
GROQ_API_KEY=

# Get OpenAI key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama runs fully offline — no key needed.
# Install: https://ollama.ai → then run: ollama pull llama3.2

# ─── Local API security ───────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
SIH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set both values before exposing the service beyond localhost.
SIH_REQUIRE_ADMIN_TOKEN=false
SIH_ADMIN_TOKEN=
